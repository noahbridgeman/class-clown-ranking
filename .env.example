# Copy to .env and fill in. Never commit .env.

# development | production (default). Development allows the SQLite fallback,
# a built-in insecure SECRET_KEY and cookies over plain http.
APP_ENV=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Required in production. In development, empty means a SQLite file in instance/.
DATABASE_URL=

# Public base URL used in e-mail links (from M2 on).
BASE_URL=http://localhost:5000

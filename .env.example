# Copy to .env and fill in. Never commit .env.

# development | production (default). Development allows the SQLite fallback,
# a built-in insecure SECRET_KEY and cookies over plain http.
APP_ENV=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Required in production. In development, empty means a SQLite file in instance/.
DATABASE_URL=

# Required in production: public base URL used in login links. Locally 127.0.0.1, not
# localhost: on macOS, localhost:5000 reaches the AirPlay receiver instead.
BASE_URL=http://127.0.0.1:5000

# smtp (production default) | console (development default, prints mails) | memory
MAIL_BACKEND=
# Required for MAIL_BACKEND=smtp. Port 465 uses implicit TLS, other ports STARTTLS
# unless MAIL_STARTTLS=false.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=true
MAIL_FROM=

# Push notifications (M8). webpush (production default) | console (development default,
# prints them) | memory. webpush needs the keys below, generate them with
#   flask --app app push keygen
PUSH_BACKEND=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Contact address the push services may write to, e.g. mailto:betrieb@example.org
VAPID_SUBJECT=
